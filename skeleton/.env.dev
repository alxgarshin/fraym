# For use in a local project. Rename this file to .env.dev

# Local settings file for a specific environment: DEV, STAGE, PROD. Overrides the global settings file.
APP_ENV=DEV

# Site address without the trailing slash
ABSOLUTE_PATH=https://www.fraym.loc

# Site address without https://www. and the trailing slash, used for sessions
COOKIE_PATH=fraym.loc

# Email for automated mailings
NOTIFY_EMAIL=your_email@yours.host

# E-mails that should receive data from the "Help" section
HELP_EMAILS=["your_email@yours.host"]

# Secret word for hashing data
PROJECT_HASH_WORD=secret

# Anti-bot check code
ANTIBOT_CODE=secret2

# Hide links to files that don't exist on this hosting
HIDE_NON_EXISTING_FILES=false

###> CORS ###
ALLOWED_ORIGINS=*
###< CORS ###

###> DB ###
# Database type: pgsql|mysql
DATABASE_TYPE=pgsql
# Host
DATABASE_HOST=database
# Port
DATABASE_PORT=5432
# Username
DATABASE_USER=fraym
# Password
DATABASE_PASSWORD=secret
# Database name
DATABASE_NAME=fraym
###< DB ###